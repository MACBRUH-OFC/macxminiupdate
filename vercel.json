{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/webhook",
      "dest": "api/index.py"
    },
    {
      "src": "/api/latest-version",
      "dest": "api/index.py"
    },
    {
      "src": "/api/update",
      "dest": "api/index.py"
    },
    {
      "src": "/api/process",
      "dest": "api/index.py"
    },
    {
      "src": "/api/bulk-zip",
      "dest": "api/index.py"
    },
    {
      "src": "/api/extract-zip",
      "dest": "api/index.py"
    },
    {
      "src": "/api/stream-cache/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/api",
      "dest": "api/index.py"
    },
    {
      "src": "/latest-version",
      "dest": "api/index.py"
    },
    {
      "src": "/update",
      "dest": "api/index.py"
    },
    {
      "src": "/process",
      "dest": "api/index.py"
    },
    {
      "src": "/bulk-zip",
      "dest": "api/index.py"
    },
    {
      "src": "/extract-zip",
      "dest": "api/index.py"
    },
    {
      "src": "/stream-cache/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "public/$1"
    }
  ]
}